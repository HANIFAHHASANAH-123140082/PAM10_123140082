<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/notesFragment">

    <fragment
        android:id="@+id/notesFragment"
        android:name="com.example.notesapp.ui.notes.NotesFragment"
        android:label="NotesFragment">

        <action
            android:id="@+id/action_notes_to_detail"
            app:destination="@id/noteDetailFragment" />

        <action
            android:id="@+id/action_notes_to_settings"
            app:destination="@id/settingsFragment" />
    </fragment>

    <fragment
        android:id="@+id/noteDetailFragment"
        android:name="com.example.notesapp.ui.detail.NoteDetailFragment"
        android:label="NoteDetailFragment">

        <argument
            android:name="noteId"
            app:argType="long"
            android:defaultValue="-1L" />
    </fragment>

    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.example.notesapp.ui.settings.SettingsFragment"
        android:label="SettingsFragment" />

</navigation>